APP_NAME=Music Intelligence API
APP_ENV=development
DEBUG=false
API_PREFIX=/api/v1
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://music_api:local-development-only@localhost:5432/music_api
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=[]
MAX_UPLOAD_SIZE_BYTES=104857600
MAX_AUDIO_DURATION_SECONDS=21600
MAX_AUDIO_OUTPUT_SIZE_BYTES=1073741824
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
SOUNDTOUCH_PATH=soundstretch
SOUNDTOUCH_VERSION=2.3.2+ds1-1
AUDIO_CONVERSION_TIMEOUT_SECONDS=21600
AUDIO_CONVERSION_MAX_CONCURRENCY=2
TEMP_DIR=./tmp
STORAGE_DIR=./storage
STORAGE_PROVIDER=local
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=music-api
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_USE_TLS=true
STORAGE_S3_PRESIGNED_URL_TTL_SECONDS=300
USER_STORAGE_QUOTA_BYTES=5368709120
UPLOAD_STAGING_TTL_SECONDS=86400
STORAGE_DEV_AUTH_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=console
DOCS_ENABLED=true
EXTERNAL_SERVICE_BASE_URL=
EXTERNAL_SERVICE_API_KEY=
